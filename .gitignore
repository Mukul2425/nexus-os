# ---------------------------------------------------------------------
# System Files & IDEs
# ---------------------------------------------------------------------
.DS_Store          # macOS specific system files
Thumbs.db          # Windows specific system files
.vscode/           # Visual Studio Code settings
.idea/             # JetBrains IDE settings (IntelliJ, WebStorm, etc.)
*.suo              # Visual Studio solution user options
# Python
__pycache__/
*.py[cod]

# Virtual Environments
.venv/
venv/

# Environment
.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/

# Type checking
.mypy_cache/

# Ruff
.ruff_cache/

# Coverage
.coverage
htmlcov/
# ---------------------------------------------------------------------
# Dependencies & Package Managers
# ---------------------------------------------------------------------
node_modules/      # Node.js dependencies
/vendor/           # PHP Composer or Go dependencies
.venv/             # Python virtual environment
env/               # Alternative Python virtual environment
backend/.env
backend/.venv
# Ignore all environment and configuration files in backend
backend/.env
backend/.env.*
backend/*.env
backend/*.local
backend/*.config

# ---------------------------------------------------------------------
# Build Outputs & Generated Files
# ---------------------------------------------------------------------
dist/              # Production build artifacts
build/             # Compiled build outputs
*.exe              # Executable files
*.dll              # Dynamic Link Libraries
*.pyc              # Python bytecode compilation

# ---------------------------------------------------------------------
# Logs & Caches
# ---------------------------------------------------------------------
*.log              # Runtime logs generated by the app
npm-debug.log*     # Node package manager debug logs
.eslintcache       # Linter cache file

# ---------------------------------------------------------------------
# Secrets & Sensitive Data
# ---------------------------------------------------------------------
.env               # Environment variable files containing credentials
.env.local         # Local overrides for configuration secrets
certs/             # SSL or private keys folder